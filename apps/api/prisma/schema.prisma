datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============ USERS ============

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole
  avatarUrl     String?
  tokenVersion  Int      @default(0)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Brand-specific
  companyName String?
  companyUrl  String?
  companyLogo String?

  // Affiliate-specific
  bio                    String?
  socialLinks            Json?

  // Payout details. Which of these is required depends on payoutMethod, which
  // is enforced by a discriminated union at the boundary rather than by the
  // database -- a nullable column cannot express "required when method is X".
  payoutMethod           PayoutMethod?
  stripeConnectAccountId String?
  paypalEmail            String?
  manualPayoutDetails    String?

  // Relations
  brandCampaigns     Campaign[]
  affiliateLinks     TrackingLink[]
  affiliateRelations BrandAffiliate[] @relation("AffiliateRelations")
  brandRelations     BrandAffiliate[] @relation("BrandRelations")
  commissions        Commission[]
  payouts            Payout[]
  conversions        Conversion[]
  fraudReviews       FraudReview[]    @relation("Reviewer")
  payoutActions      PayoutEvent[]    @relation("PayoutActor")
  balanceAdjustments BalanceAdjustment[]
  subscriptions      Subscription[]
  notifications      Notification[]
  notificationPrefs  NotificationPreference[]
  refreshTokens      RefreshToken[]
  webhookEndpoints   WebhookEndpoint[]

  @@index([email])
  @@index([role])
}

/// One issued refresh token.
///
/// Refresh tokens used to be purely stateless: signed, carrying a
/// `tokenVersion`, and never recorded. That made them impossible to revoke
/// individually (the only lever bumped `tokenVersion`, killing every session
/// the user had) and impossible to *detect* -- a stolen token worked until it
/// expired and left no trace at all.
///
/// Recording them costs a row and a lookup per refresh. What it buys is
/// rotation and reuse detection, neither of which a stateless token can
/// express.
model RefreshToken {
  id     String @id @default(cuid())
  /// Every token minted from one login shares a family. Rotation moves the
  /// family forward; detection revokes the whole family at once, because when
  /// a token is presented twice you cannot tell which holder is the attacker.
  familyId String
  /// SHA-256 of the token, never the token itself. A leaked database of
  /// hashes is useless; a leaked database of raw tokens is a set of live
  /// sessions. Unique so a duplicate insert fails loudly instead of quietly
  /// creating a second row for one token.
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  issuedAt   DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  /// Set when this token mints its successor. A token presented *after* this
  /// is set has been used twice, which is the signal the whole design exists
  /// to produce.
  rotatedAt DateTime?
  revokedAt DateTime?

  userAgent String?
  ipHash    String?

  @@index([familyId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

enum UserRole {
  BRAND
  AFFILIATE
  ADMIN
}

// ============ BRAND-AFFILIATE RELATIONSHIP ============

model BrandAffiliate {
  id            String             @id @default(cuid())
  brandId       String
  brand         User               @relation("BrandRelations", fields: [brandId], references: [id])
  affiliateId   String
  affiliate     User               @relation("AffiliateRelations", fields: [affiliateId], references: [id])
  status        RelationshipStatus @default(PENDING)
  applicationMessage String?

  // Override: brand can set custom commission for this affiliate
  customCommission Json?

  appliedAt     DateTime  @default(now())
  approvedAt    DateTime?
  rejectedAt    DateTime?
  deactivatedAt DateTime?

  overrideEvents CommissionOverrideEvent[]

  @@unique([brandId, affiliateId])
  @@index([brandId, status])
  @@index([affiliateId, status])
}

enum RelationshipStatus {
  PENDING
  APPROVED
  REJECTED
  DEACTIVATED
}

// ============ CAMPAIGNS ============

model Campaign {
  id             String         @id @default(cuid())
  brandId        String
  brand          User           @relation(fields: [brandId], references: [id])
  name           String
  description    String?
  slug           String         @unique
  landingPageUrl String
  allowedDomains String[]
  status         CampaignStatus @default(DRAFT)

  commissionStructure Json

  attributionModel      AttributionModel @default(LAST_CLICK)
  attributionWindowDays Int              @default(30)
  cookieLifetimeDays    Int              @default(30)
  lockPeriodDays        Int              @default(30)

  isOpen Boolean @default(true)

  startDate DateTime
  endDate   DateTime?

  trackingLinks  TrackingLink[]
  conversions    Conversion[]
  commissions    Commission[]
  creativeAssets CreativeAsset[]
  apiKeys        CampaignApiKey[]
  subscriptions  Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([status])
  @@index([slug])
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum AttributionModel {
  FIRST_CLICK
  LAST_CLICK
  LINEAR
}

// ============ CAMPAIGN API KEYS ============

/// Credentials a brand's storefront uses to sign conversion postbacks.
///
/// Scoped to a campaign rather than a brand so that a key leaked from one
/// integration cannot report sales against every other programme the brand
/// runs.
///
/// The secret is *encrypted*, not hashed. Verifying an HMAC signature means
/// recomputing it, which requires the original bytes -- a hash would make
/// verification impossible. See lib/secret-box.ts for the trade-off that
/// implies.
model CampaignApiKey {
  id         String    @id @default(cuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id])

  keyId           String @unique
  secretEncrypted String
  label           String

  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([campaignId])
}

// ============ TRACKING LINKS ============

model TrackingLink {
  id             String   @id @default(cuid())
  affiliateId    String
  affiliate      User     @relation(fields: [affiliateId], references: [id])
  campaignId     String
  campaign       Campaign @relation(fields: [campaignId], references: [id])

  shortCode      String   @unique
  destinationUrl String
  customAlias    String?
  isActive       Boolean  @default(true)

  // Denormalized counters (updated by workers, not real-time)
  clickCount      Int     @default(0)
  conversionCount Int     @default(0)
  revenue         Decimal @db.Decimal(12, 2) @default(0)

  clickEvents ClickEvent[]
  conversions Conversion[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())

  @@index([affiliateId])
  @@index([campaignId])
  @@index([shortCode])
}

// ============ CLICK EVENTS ============

model ClickEvent {
  id                  String       @id @default(cuid())
  trackingLinkId      String
  trackingLink        TrackingLink @relation(fields: [trackingLinkId], references: [id])
  timestamp           DateTime
  ipHash              String
  userAgent           String
  referrer            String?
  country             String?
  region              String?
  deviceType          String?
  browser             String?
  os                  String?
  attributionCookieId String
  subIds              Json?

  /// Traffic that was served but must not be counted.
  ///
  /// Rows are still written -- knowing a post was previewed 40 times in Slack
  /// is useful, and deleting the evidence makes the filtered totals
  /// unverifiable. They are excluded from counters, analytics and
  /// attribution instead.
  trafficKind         String  @default("human")
  isCounted           Boolean @default(true)

  conversions Conversion[]

  @@index([trackingLinkId])
  @@index([attributionCookieId])
  @@index([timestamp])
  @@index([ipHash])
  /// Analytics reads only counted clicks, so the filter belongs in the index.
  @@index([isCounted, timestamp])
}

// ============ CONVERSIONS ============

model Conversion {
  id               String           @id @default(cuid())
  trackingLinkId   String
  trackingLink     TrackingLink     @relation(fields: [trackingLinkId], references: [id])
  campaignId       String
  campaign         Campaign         @relation(fields: [campaignId], references: [id])
  affiliateId      String
  affiliate        User             @relation(fields: [affiliateId], references: [id])
  clickEventId     String?
  clickEvent       ClickEvent?      @relation(fields: [clickEventId], references: [id])

  externalOrderId  String
  conversionValue  Decimal          @db.Decimal(12, 2)
  commissionAmount Decimal          @db.Decimal(10, 2)
  status           ConversionStatus @default(PENDING)

  customerEmailHash   String?
  isFirstTimeCustomer Boolean @default(true)

  /// Sub-IDs copied from the click that earned this conversion.
  ///
  /// Denormalised deliberately. The alternative is joining back through
  /// clickEventId, which is nullable and points at a row that may be pruned
  /// long before the commission is paid -- so revenue would stop being
  /// attributable to a placement exactly when someone wants to check it.
  subIds              Json?

  notes            String?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?

  occurredAt       DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  commissions      Commission[]
  fraudReviews     FraudReview[]

  @@unique([campaignId, externalOrderId])
  @@index([affiliateId, status])
  @@index([campaignId, status])
  @@index([trackingLinkId])
  @@index([occurredAt])
  /// Supports keyset pagination: the columns and their order match the
  /// ORDER BY exactly, including direction, so the seek is an index scan
  /// rather than a sort. An index on occurredAt alone is not enough -- the
  /// tie-breaker has to be in the index or Postgres still has to sort within
  /// each timestamp.
  @@index([occurredAt(sort: Desc), id(sort: Desc)])
}

enum ConversionStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============ COMMISSIONS ============

model Commission {
  id            String           @id @default(cuid())
  affiliateId   String
  affiliate     User             @relation(fields: [affiliateId], references: [id])
  campaignId    String
  campaign      Campaign         @relation(fields: [campaignId], references: [id])
  conversionId  String
  conversion    Conversion       @relation(fields: [conversionId], references: [id])

  amount        Decimal          @db.Decimal(10, 2)
  status        CommissionStatus @default(PENDING)

  lockExpiresAt DateTime?
  approvedAt    DateTime?
  paidAt        DateTime?

  payoutId      String?
  payout        Payout?          @relation(fields: [payoutId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([affiliateId, status])
  @@index([payoutId])
  @@index([lockExpiresAt])
}

enum CommissionStatus {
  PENDING
  LOCKED
  APPROVED
  INCLUDED_IN_PAYOUT
  PAID
  REJECTED
  CLAWED_BACK
}

// ============ PAYOUTS ============

model Payout {
  id          String        @id @default(cuid())
  affiliateId String
  affiliate   User          @relation(fields: [affiliateId], references: [id])

  amount      Decimal       @db.Decimal(10, 2)
  feeAmount   Decimal       @db.Decimal(10, 2) @default(0)
  netAmount   Decimal       @db.Decimal(10, 2)
  currency    String        @default("USD")

  method      PayoutMethod
  status      PayoutStatus  @default(PENDING)

  stripeTransferId String?
  failureReason    String?

  /// Client-supplied key for safe retries. Unique per affiliate rather than
  /// globally: two affiliates independently sending "retry-1" is ordinary,
  /// and a global constraint would make the second one fail.
  idempotencyKey   String?

  periodStart DateTime
  periodEnd   DateTime
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  commissions Commission[]
  events      PayoutEvent[]

  @@unique([affiliateId, idempotencyKey])
  @@index([affiliateId, status])
  @@index([status])
}

/// Audit trail for payout state changes.
///
/// This is money leaving the platform, so "who moved this and when" must be
/// answerable months later. The payout row only carries its current state;
/// without this, a payout that went PENDING -> PROCESSING -> FAILED ->
/// PROCESSING -> PAID looks identical to one that went straight through.
model PayoutEvent {
  id         String       @id @default(cuid())
  payoutId   String
  payout     Payout       @relation(fields: [payoutId], references: [id])
  fromStatus PayoutStatus
  toStatus   PayoutStatus
  actorId    String?
  actor      User?        @relation("PayoutActor", fields: [actorId], references: [id])
  reason     String?
  reference  String?
  createdAt  DateTime     @default(now())

  @@index([payoutId])
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum PayoutMethod {
  STRIPE_CONNECT
  PAYPAL
  MANUAL
}

/// Audit of per-affiliate commission overrides.
///
/// The override itself lives on BrandAffiliate as a single JSON value, so
/// setting a new one destroys the previous. For something that decides how
/// much a partner is paid, "what was the rate in March and who changed it" has
/// to be answerable.
model CommissionOverrideEvent {
  id             String   @id @default(cuid())
  brandAffiliateId String
  brandAffiliate BrandAffiliate @relation(fields: [brandAffiliateId], references: [id])
  actorId        String
  previousValue  Json?
  newValue       Json?
  createdAt      DateTime @default(now())

  @@index([brandAffiliateId])
}

/// A referred customer on a recurring-commission campaign.
///
/// Exists because a recurring deal is a promise about the *future*: "30% for
/// twelve months" cannot be satisfied by the single commission the first sale
/// produces. The subscription is what remembers how many periods are left and
/// on what terms.
model Subscription {
  id                   String   @id @default(cuid())
  campaignId           String
  campaign             Campaign @relation(fields: [campaignId], references: [id])
  affiliateId          String
  affiliate            User     @relation(fields: [affiliateId], references: [id])
  trackingLinkId       String
  trackingLink         TrackingLink @relation(fields: [trackingLinkId], references: [id])

  originalConversionId String   @unique
  customerEmailHash    String?
  externalReference    String

  /// The commission terms as they stood when this subscription started.
  ///
  /// Snapshotted rather than read live: a customer who signed up under a 30%
  /// deal keeps it for their whole term, even if the brand later changes the
  /// campaign. Reading the campaign each month would let a brand retroactively
  /// cut a rate they already promised.
  commissionSnapshot   Json

  totalPeriods         Int
  completedPeriods     Int      @default(1)

  status               SubscriptionStatus @default(ACTIVE)
  startedAt            DateTime @default(now())
  cancelledAt          DateTime?

  @@unique([campaignId, externalReference])
  @@index([affiliateId, status])
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

/// Transactional outbox for notifications.
///
/// Rows are written in the *same transaction* as the state change that caused
/// them. If the transaction rolls back, the notification never existed; if it
/// commits, the notification is guaranteed to exist and a worker will deliver
/// it. Sending after the commit instead would mean a crash in between loses
/// the message with no record that anything was owed -- which is exactly the
/// hole fraud.evaluate still has.
model Notification {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])

  type      String
  payload   Json

  readAt    DateTime?
  sentAt    DateTime?
  attempts  Int                @default(0)
  lastError String?
  status    NotificationStatus @default(PENDING)

  createdAt DateTime           @default(now())

  @@index([userId, readAt])
  @@index([status, createdAt])
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// Per-user opt-outs.
///
/// Absence means opted in: a user who has never touched their preferences
/// should still hear that they have been paid.
model NotificationPreference {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id])
  type    String
  enabled Boolean @default(true)

  @@unique([userId, type])
}

// ============ BALANCE ADJUSTMENTS ============

/// A correction to an affiliate's balance that is not tied to a commission's
/// own lifecycle.
///
/// Needed because a commission that has already been PAID cannot be clawed
/// back by changing its status -- the money has left. Instead we record a
/// negative adjustment, which is netted off the affiliate's next payout. This
/// is how an accounting system handles a reversal it cannot un-post.
model BalanceAdjustment {
  id              String   @id @default(cuid())
  affiliateId     String
  affiliate       User     @relation(fields: [affiliateId], references: [id])

  /// Negative for a clawback. Positive is allowed so goodwill credits can use
  /// the same mechanism.
  amount          Decimal  @db.Decimal(10, 2)
  reason          String
  conversionId    String?

  /// Set once this adjustment has been applied to a payout, so it is netted
  /// off exactly once.
  settledPayoutId String?

  createdAt       DateTime @default(now())

  @@index([affiliateId, settledPayoutId])
}

// ============ CREATIVE ASSETS ============

model CreativeAsset {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  name       String
  type       AssetType
  url        String
  width      Int?
  height     Int?
  sizeBytes  Int?
  createdAt  DateTime @default(now())

  @@index([campaignId])
}

enum AssetType {
  BANNER
  LOGO
  VIDEO
  TEXT_SWIPE
  OTHER
}

// ============ FRAUD REVIEW ============

model FraudReview {
  id            String       @id @default(cuid())
  conversionId  String
  conversion    Conversion   @relation(fields: [conversionId], references: [id])
  reviewerId    String?
  reviewer      User?        @relation("Reviewer", fields: [reviewerId], references: [id])
  riskScore     Int
  signals       Json
  decision      FraudDecision @default(PENDING)
  notes         String?
  createdAt     DateTime     @default(now())
  decidedAt     DateTime?

  @@index([conversionId])
  @@index([decision])
}

enum FraudDecision {
  PENDING
  CLEARED
  FLAGGED
  BLOCKED
}

// ============ IDEMPOTENCY ============

/// A claimed idempotency key and, once the request finishes, its response.
///
/// One endpoint was idempotent before this: payout requests, via a unique
/// constraint on (affiliateId, idempotencyKey). That guaranteed the *invariant*
/// -- one payout per key -- but not the *semantics*: a retry got whatever the
/// service happened to return second time round rather than the original
/// response, and a retry arriving while the first was still running raced it.
///
/// Storing the response is what turns "at least once" delivery into
/// "effectively once" processing, which is the guarantee a retrying client
/// actually needs.
model IdempotencyKey {
  id       String @id @default(cuid())
  key      String
  /// Method plus route pattern. Scoped per endpoint so the same key reused
  /// against a different operation is not mistaken for a retry of this one.
  endpoint String

  userId String?

  /// SHA-256 of the canonical body. The same key with a *different* body is a
  /// client bug; replaying the first response would hide it, so it is refused.
  fingerprint String

  status       IdempotencyStatus @default(IN_PROGRESS)
  responseCode Int?
  responseBody Json?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@unique([key, endpoint])
  @@index([expiresAt])
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

// ============ OUTBOUND WEBHOOKS ============

/// A brand's subscription to events on their own account.
///
/// The signing secret is sealed rather than hashed, for the same reason a
/// campaign API key is: we have to produce the HMAC, not merely check one, so
/// the original bytes have to come back. `secret-box.ts` explains the bargain
/// that makes.
model WebhookEndpoint {
  id      String @id @default(cuid())
  brandId String
  brand   User   @relation(fields: [brandId], references: [id])

  url             String
  secretEncrypted String
  /// Explicit subscriptions, not "everything". An endpoint written for one
  /// event type would otherwise start receiving a payload it has never seen
  /// the moment we ship a new one.
  eventTypes      String[]

  status         WebhookEndpointStatus @default(ACTIVE)
  /// Why we stopped sending. A brand whose integration goes quiet needs to be
  /// able to find out that their own endpoint answered 410.
  disabledReason String?

  /// Circuit breaker state, in the database rather than in the worker's
  /// memory. It has to survive a deploy -- a restart that reset every breaker
  /// would send the whole backlog at a subscriber that is still down, which is
  /// the behaviour the breaker exists to prevent. It also has to be legible to
  /// whichever instance holds the delivery lease, which is not necessarily the
  /// one that tripped it.
  breakerState        WebhookBreakerState @default(CLOSED)
  consecutiveFailures Int                 @default(0)
  breakerOpenedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([brandId])
  @@index([status])
}

enum WebhookEndpointStatus {
  ACTIVE
  DISABLED
}

enum WebhookBreakerState {
  CLOSED
  OPEN
  HALF_OPEN
}

/// One event owed to one endpoint.
///
/// Written in the same transaction as the state change that caused it, like a
/// Notification and for the same reason: POSTing after the commit means a
/// crash in between loses the event with no record that anything was owed.
///
/// Fanned out to one row per endpoint at write time rather than resolving
/// subscribers at delivery time, so that a brand editing their subscriptions
/// afterwards does not retroactively change what was already owed.
model WebhookDelivery {
  id         String          @id @default(cuid())
  endpointId String
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  eventType String
  payload   Json

  status   WebhookDeliveryStatus @default(PENDING)
  attempts Int                   @default(0)

  /// The last thing that happened, kept apart so a delivery log can say
  /// "connection refused" and "returned 503" rather than merging both into
  /// "failed".
  lastStatusCode Int?
  lastError      String?

  /// When this becomes eligible again. Also how an open breaker parks a
  /// delivery it refused to attempt, without spending an attempt on it.
  nextAttemptAt DateTime  @default(now())
  deliveredAt   DateTime?

  createdAt DateTime @default(now())

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}
