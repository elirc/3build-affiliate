# ============ Database ============
# Host port 5452, not 5432 -- see the comment in docker-compose.yml.
DATABASE_URL=postgresql://affiliate_user:affiliate_pass@localhost:5452/affiliate_dev

# ============ Redis ============
REDIS_URL=redis://localhost:6389

# ============ API ============
API_PORT=3001
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=replace-me-with-long-random-string
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Accepts only "true" or "false". Leave as false to run the background workers.
DISABLE_WORKERS=false

# ============ Redirect Service ============
REDIRECT_PORT=3002
DEFAULT_FALLBACK_URL=https://example.com
IP_SALT=replace-me-with-random-salt
COOKIE_DOMAIN=localhost

# ============ Web ============
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_REDIRECT_URL=http://localhost:3002

# ============ Stripe (Phase 4) ============
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ============ Platform ============
PLATFORM_FEE_PERCENT=5
NODE_ENV=development

# ============ Service-to-service ============
# Shared secret the redirect service presents to the API's /internal routes.
# Must match on both sides. Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=replace-me-with-a-long-random-internal-token
# Where the redirect service reaches the API for cache-miss lookups.
API_INTERNAL_URL=http://localhost:3001
# How long a shopper may wait on that lookup before we serve the fallback.
LINK_LOOKUP_TIMEOUT_MS=150

# Encrypts campaign postback secrets at rest. 32 bytes of hex.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this makes every existing campaign API key undecryptable.
POSTBACK_ENCRYPTION_KEY=replace-me-with-64-hex-characters-0000000000000000000000000000
# Sustained postback rate per API key. The burst ceiling is 200, set in
# apps/api/src/lib/rate-limiter.ts alongside the other tiers.
POSTBACK_RATE_LIMIT_PER_MINUTE=100

# Where creative uploads are written (relative to apps/api).
ASSET_STORAGE_PATH=./storage/assets

# ============ Outbound webhooks ============
# Lets webhook delivery reach private addresses. Leave false anywhere the
# internet can reach: a webhook url is an address a stranger chooses and the
# API dials. The integration suite sets it because its stub server is on
# loopback; nothing else should.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
