# ============ Database ============
# Host port 5452, not 5432 -- see the comment in docker-compose.yml.
DATABASE_URL=postgresql://affiliate_user:affiliate_pass@localhost:5452/affiliate_dev

# ============ Redis ============
REDIS_URL=redis://localhost:6389

# ============ API ============
API_PORT=3001
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=replace-me-with-long-random-string
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Accepts only "true" or "false". Leave as false to run the background workers.
DISABLE_WORKERS=false

# ============ Redirect Service ============
REDIRECT_PORT=3002
DEFAULT_FALLBACK_URL=https://example.com
IP_SALT=replace-me-with-random-salt
COOKIE_DOMAIN=localhost

# ============ Web ============
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_REDIRECT_URL=http://localhost:3002

# ============ Stripe (Phase 4) ============
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ============ Platform ============
PLATFORM_FEE_PERCENT=5
NODE_ENV=development
